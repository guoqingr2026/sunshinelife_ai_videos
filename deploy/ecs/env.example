# 复制为 /opt/sunshinelife_ai_videos/.env
PORT=3012
# 相对路径均相对于 backend/（非 dist/），实际目录：backend/storage/
STORAGE_PATH=./storage
# ECS 也可写绝对路径：STORAGE_PATH=/opt/sunshinelife_ai_videos/backend/storage

# 子路径部署（与 englishlearn 共存时填写）
PUBLIC_BASE_PATH=/sunshinelife_ai_videos

# Remotion：Linux 上常用 Chromium（install.sh 会尝试安装）
# REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium-browser

# HyperFrames 图像生成（可选）
# IMAGE_API_URL=
# IMAGE_API_KEY=
# IMAGE_MODEL=dall-e-3
